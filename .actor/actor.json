{
  "actorSpecification": 1,
  "name": "google-news-scraper",
  "title": "Google News Scraper - Articles by Keyword & Topic",
  "description": "Search current Google News articles by keyword, topic, or top headlines. Use for AI news monitoring, market briefs, and topic digests; returns title, source, link, publish date, snippet, feed type, country, language, and scrape time. No login or API key needed.",
  "version": "1.0",
  "categories": ["NEWS", "BUSINESS", "OTHER"],
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "output": "./output_schema.json",
  "exampleRunInput": {
    "body": "{\"queries\":[\"artificial intelligence\"],\"topics\":[],\"topHeadlines\":false,\"country\":\"US\",\"language\":\"en\",\"maxArticlesPerFeed\":5,\"proxyConfiguration\":{\"useApifyProxy\":false}}",
    "contentType": "application/json; charset=utf-8"
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "articles": {
          "title": "Articles",
          "transformation": {
            "fields": ["title", "source", "publishedAt", "snippet", "link", "feedType", "feedQuery", "country", "language", "scrapedAt"]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": { "label": "Title", "format": "text" },
              "source": { "label": "Source", "format": "text" },
              "publishedAt": { "label": "Published", "format": "date" },
              "snippet": { "label": "Snippet", "format": "text" },
              "link": { "label": "Link", "format": "link" },
              "feedType": { "label": "Feed", "format": "text" },
              "feedQuery": { "label": "Query/Topic", "format": "text" },
              "country": { "label": "Country", "format": "text" },
              "language": { "label": "Language", "format": "text" },
              "scrapedAt": { "label": "Scraped At", "format": "text" }
            }
          }
        }
      }
    }
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts running. Number of events charged depends on Actor memory (one event per GB, minimum one event).",
          "isOneTimeEvent": true,
          "eventPriceUsd": 0.00005
        },
        "article-scraped": {
          "eventTitle": "Article Scraped",
          "eventDescription": "Charged for each Google News article extracted and saved to the dataset.",
          "isOneTimeEvent": false,
          "isPrimaryEvent": true,
          "eventPriceUsd": 0.001
        }
      }
    }
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 512,
    "timeoutSecs": 3600
  },
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 2048
}
