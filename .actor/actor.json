{
  "actorSpecification": 1,
  "name": "google-news-scraper",
  "title": "Google News Scraper & Monitor - Brand Alerts",
  "description": "Track US and global Google News coverage for brands, competitors, markets, and policy. Get change labels, source intelligence, private history, and ready-to-use CSV and Markdown reports.",
  "version": "1.1",
  "categories": ["NEWS", "BUSINESS"],
  "categoriesVersion": "1.0.0",
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "output": "./output_schema.json",
  "exampleRunInput": {
    "body": "{\"queries\":[\"\\\"OpenAI\\\" OR \\\"Anthropic\\\"\"],\"topics\":[],\"topHeadlines\":false,\"country\":\"US\",\"language\":\"en\",\"maxArticlesPerFeed\":1,\"trackChanges\":true,\"monitorName\":\"us-ai-competitor-watch\",\"observationHistoryLimit\":10,\"newArticleWindowHours\":24,\"breakingWindowHours\":6,\"proxyConfiguration\":{\"useApifyProxy\":false}}",
    "contentType": "application/json; charset=utf-8"
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "articles": {
          "title": "Articles",
          "transformation": {
            "fields": ["title", "source", "monitoringStatus", "changeSeverity", "changeSummary", "changeSignals", "freshnessBucket", "ageHours", "publisherDomain", "storyClusterId", "publishedAt", "snippet", "sourceUrl", "link", "feedType", "feedQuery", "country", "language", "previousSeenAt", "observationCount", "scrapedAt"]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": { "label": "Title", "format": "text" },
              "source": { "label": "Source", "format": "text" },
              "monitoringStatus": { "label": "Monitor Status", "format": "text" },
              "changeSeverity": { "label": "Severity", "format": "text" },
              "changeSummary": { "label": "Change Summary", "format": "text" },
              "changeSignals": { "label": "Signals", "format": "array" },
              "freshnessBucket": { "label": "Freshness", "format": "text" },
              "ageHours": { "label": "Age (hours)", "format": "number" },
              "publisherDomain": { "label": "Publisher Domain", "format": "text" },
              "storyClusterId": { "label": "Story Cluster", "format": "text" },
              "sourceUrl": { "label": "Publisher URL", "format": "link" },
              "publishedAt": { "label": "Published", "format": "date" },
              "snippet": { "label": "Snippet", "format": "text" },
              "link": { "label": "Link", "format": "link" },
              "feedType": { "label": "Feed", "format": "text" },
              "feedQuery": { "label": "Query/Topic", "format": "text" },
              "country": { "label": "Country", "format": "text" },
              "language": { "label": "Language", "format": "text" },
              "previousSeenAt": { "label": "Previously Seen", "format": "date" },
              "observationCount": { "label": "Observations", "format": "number" },
              "scrapedAt": { "label": "Scraped At", "format": "text" }
            }
          }
        }
      }
    }
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts running. Number of events charged depends on Actor memory (one event per GB, minimum one event).",
          "isOneTimeEvent": true,
          "eventPriceUsd": 0.00005
        },
        "article-scraped": {
          "eventTitle": "Article Scraped",
          "eventDescription": "Charged for each Google News article extracted and saved to the dataset.",
          "isOneTimeEvent": false,
          "isPrimaryEvent": true,
          "eventPriceUsd": 0.0008
        }
      }
    }
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 256,
    "timeoutSecs": 3600
  },
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 2048
}
