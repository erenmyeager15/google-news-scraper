{
  "name": "google-news-scraper",
  "version": "1.0.0",
  "description": "Apify Actor that reads structured metadata from Google News RSS feeds",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test dist/input.test.js dist/mappers.test.js dist/feed-client.test.js dist/scraper.test.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "apify",
    "google-news",
    "news",
    "rss",
    "scraper"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "apify": "^3.2.0",
    "fast-xml-parser": "5.10.1",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
